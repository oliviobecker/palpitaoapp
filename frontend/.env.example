# ---------------------------------------------------------------------------
# Frontend environment reference.
# Angular uses src/environments/*.ts for build-time config, but this file
# documents the values you may need locally. Copy to ".env" for tooling that
# reads it.
# ---------------------------------------------------------------------------
# Base URL of the backend API in development (src/environments/environment.development.ts).
# Production builds call "/api", where IIS mounts the API.
API_BASE_URL=https://localhost:7099
