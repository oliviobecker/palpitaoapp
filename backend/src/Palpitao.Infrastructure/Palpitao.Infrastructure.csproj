<Project Sdk="Microsoft.NET.Sdk">

  <!-- The adapters behind the Application's ports: EF Core on PostgreSQL (context, configurations,
       migrations), the external fixture/results/team providers, JWT + BCrypt, Tesseract and the
       background jobs. -->

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- Relational and the JWT handler are pinned explicitly so their versions stay the ones the
         web project resolved before the split, instead of drifting with whatever pulls them in. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Tesseract" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK imported this one implicitly; class libraries do not. -->
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Palpitao.Application\Palpitao.Application.csproj" />
  </ItemGroup>

</Project>
